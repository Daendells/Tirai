{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "default_locale": "en",
  "permissions": ["storage", "idle", "scripting", "activeTab"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "optional_host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://discord.com/*",
    "https://app.slack.com/*",
    "https://*.whereby.com/*",
    "https://meet.jit.si/*"
  ],
  "action": { "default_title": "__MSG_extName__" },
  "commands": {
    "toggle-full": {
      "suggested_key": { "default": "Alt+Shift+Z" },
      "description": "__MSG_cmdToggleFull__"
    },
    "toggle-off": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "__MSG_cmdToggleOff__"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": [
        "shared/settings.js", "shared/mode.js", "shared/geometry.js", "content/regions.js",
        "content/holes.js", "content/lamp.js", "content/curtain.js", "content/whatsapp.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
